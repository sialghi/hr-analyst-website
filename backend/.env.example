# Database - Railway/Supabase akan kasih connection string Postgres, contoh:
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Secret untuk JWT (WAJIB diganti di production, isi string acak panjang)
JWT_SECRET_KEY=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# API key untuk endpoint n8n (dipakai di header X-API-Key)
API_KEY=ganti-dengan-api-key-untuk-n8n

# Domain frontend yang boleh akses API ini (untuk CORS), contoh:
FRONTEND_ORIGIN=https://nama-app-anda.vercel.app

# Dipakai seed.py untuk membuat akun HR Master pertama
SEED_HR_MASTER_EMAIL=admin@perusahaan.com
SEED_HR_MASTER_PASSWORD=ganti-password-ini
